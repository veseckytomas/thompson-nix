{
  pkgs,
  lib,
  ...
}: {
  imports = [
    ./sugar-dark.nix
    # ./catppuccin.nix
  ];
  services = {
    xserver.enable = true;
    displayManager = {
      defaultSession = "qtile";
      sddm = {
        enable = true;
        package = pkgs.kdePackages.sddm;
        autoNumlock = lib.mkDefault true;
      };
    };
  };
  environment.systemPackages = with pkgs; [
    libsForQt5.qt5.qtquickcontrols2
    libsForQt5.qt5.qtgraphicaleffects
  ];
}

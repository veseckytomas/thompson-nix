[connection]
id=cvut-vpn
uuid=bfea377e-63f4-4224-a1a9-1a19bc2003ed
type=vpn
autoconnect=false
permissions=user:vesecto:;

[vpn]
authtype=password
autoconnect-flags=0
certsigs-flags=0
cookie-flags=2
disable_udp=no
enable_csd_trojan=no
gateway=vpn.cvut.cz
gateway-flags=2
gwcert-flags=2
lasthost-flags=0
pem_passphrase_fsid=no
prevent_invalid_cert=no
protocol=anyconnect
resolve-flags=2
stoken_source=disabled
xmlconfig-flags=0
service-type=org.freedesktop.NetworkManager.openconnect

[vpn-secrets]
form:main:group_list=vpncvut
form:main:username=vesecto1
lasthost=vpn.cvut.cz
save_passwords=yes

[ipv4]
method=auto

[ipv6]
addr-gen-mode=default
method=auto

[proxy]

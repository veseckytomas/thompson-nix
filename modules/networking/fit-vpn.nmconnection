[connection]
id=fit-vpn
uuid=8963a4d6-2a94-450c-95dc-c8ac6024d8f6
type=vpn
permissions=user:vesecto:;

[vpn]
ca=/home/vesecto/.cert/nm-openvpn/fit-vpn-ca.pem
challenge-response-flags=2
cipher=AES-256-CBC
connect-timeout=2
connection-type=password
dev=tun
password-flags=1
push-peer-info=yes
remote=vpn.fit.cvut.cz:1194:udp
username=vesecto1
verify-x509-name=name:vpn.fit.cvut.cz
service-type=org.freedesktop.NetworkManager.openvpn

[ipv4]
method=auto
never-default=true

[ipv6]
addr-gen-mode=default
method=auto
never-default=true

[proxy]

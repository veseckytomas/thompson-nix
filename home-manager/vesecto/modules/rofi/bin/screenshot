rofi_command="rofi -theme $HOME/.config/rofi/config/screenshot.rasi"

dir="$HOME/Pictures/Screenshots"

# Buttons
layout=$(cat $HOME/.config/rofi/config/screenshot.rasi | grep BUTTON | cut -d'=' -f2 | tr -d '[:blank:],*/')
clipboardarea=" Clipboard Area"
screen=" Capture Desktop"
area="󰒉 Capture Area"
inthree="󰬼 Take in 3s"
inten="󰿩 Take in 10s"

# take shots
clipboardarea() {
  flameshot gui -c
}

shotnow() {
	flameshot screen --path "$dir"
}

shot3() {
	flameshot screen --path "$dir" --delay 3000
}

shot10() {
	flameshot screen --path "$dir" --delay 10000
}

shotarea() {
	flameshot gui --path "$dir" --cliboard
}

if [[ ! -d "$dir" ]]; then
	mkdir -p "$dir"
fi

# Variable passed to rofi
options="$clipboardarea\n$screen\n$area\n$inthree\n$inten"

chosen="$(echo -e "$options" | $rofi_command -p 'Take A Shot' -dmenu -selected-row 0)"
case $chosen in
$clipboardarea)
	cliboardarea
	;;
$screen)
	shotnow
	;;
$area)
	shotarea
	;;
$infive)
	shot5
	;;
$inten)
	shot10
	;;
esac

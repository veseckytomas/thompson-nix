function nvimf() {
  FILE=$(fzf)
  if [[ $FILE  != "" ]]; then
    nvim "$FILE"
  fi
}
function y() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
	yazi "$@" --cwd-file="$tmp"
	if cwd="$(command cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
		builtin cd -- "$cwd"
	fi
	rm -f -- "$tmp"
}
function gbr {
	git brd $1
	git push -d origin $1
}
function take {
	mkdir $1
	cd $1
}

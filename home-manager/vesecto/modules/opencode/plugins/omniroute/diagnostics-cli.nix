{
  config,
  lib,
  pkgs,
  ...
}: let
  cfg = config.opencodePlugins.omniroute;
  cli = pkgs.writeShellApplication {
    name = "omniroute";
    runtimeInputs = [pkgs.sqlite pkgs.coreutils];
    text = builtins.readFile ./diagnostics-cli.sh;
  };
in {
  config = lib.mkIf cfg.enable {
    home.packages = [cli];
  };
}

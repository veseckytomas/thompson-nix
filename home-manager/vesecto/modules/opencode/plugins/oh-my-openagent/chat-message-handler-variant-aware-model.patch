+import { parseModelString } from "@oh-my-opencode/model-core"
+
+function isSameModel(a: string, b: string): boolean {
+  const pa = parseModelString(a)
+  const pb = parseModelString(b)
+  if (!pa || !pb) return a.toLowerCase() === b.toLowerCase()
+  return pa.providerID.toLowerCase() === pb.providerID.toLowerCase() && pa.modelID.toLowerCase() === pb.modelID.toLowerCase()
+}
 

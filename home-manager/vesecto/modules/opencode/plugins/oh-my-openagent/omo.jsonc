  "[opencode]": {
    "auto_update": false,
    "runtime_fallback": {
      "enabled": false
    },
    "team_mode": {
      "enabled": true,
      "max_parallel_members": 5,
      "max_members": 8,
      "tmux_visualization": true
    },
    "disabled_tools": [
      "grep_app_searchgithub"
    ]

{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",
  "auto_update": false,
  "runtime_fallback": {
    "enabled": true,
    "retry_on_errors": [
      429,
      503,
      529
    ],
    "max_fallback_attempts": 3,
    "cooldown_seconds": 60
  },
  "agents": {
    "sisyphus": {
      "model": "litellm/kimi-k2.6",
      "fallback_models": [
        {
          "model": "openai/gpt-5.5",
          "variant": "medium"
        }
      ]
    },
    "hephaestus": {
      "model": "openai/gpt-5.5",
      "variant": "medium",
      "fallback_models": [
        {
          "model": "litellm/deepseek-v4-pro"
        }
      ]
    },
    "oracle": {
      "model": "openai/gpt-5.5",
      "variant": "high",
      "fallback_models": [
        {
          "model": "google/gemini-3.1-pro-preview",
          "variant": "high"
        },
        {
          "model": "litellm/deepseek-v4-pro"
        },
        {
          "model": "litellm/deepseek-v4-pro-thinking"
        }
      ]
    },
    "librarian": {
      "model": "openai/gpt-5.4-mini-fast",
      "fallback_models": [
        {
          "model": "openai/gpt-5.4-nano"
        }
      ]
    },
    "explore": {
      "model": "openai/gpt-5.4-mini-fast",
      "fallback_models": [
        {
          "model": "openai/gpt-5.4-nano"
        }
      ]
    },
    "multimodal-looker": {
      "model": "openai/gpt-5.5",
      "variant": "medium",
      "fallback_models": [
        {
          "model": "openai/gpt-5-nano"
        },
        {
          "model": "github-copilot/gpt-5-nano"
        }
      ]
    },
    "prometheus": {
      "model": "litellm/kimi-k2.6",
      "fallback_models": [
        {
          "model": "openai/gpt-5.5",
          "variant": "high"
        },
        {
          "model": "google/gemini-3.1-pro-preview"
        }
      ]
    },
    "metis": {
      "model": "litellm/kimi-k2.6",
      "fallback_models": [
        {
          "model": "openai/gpt-5.5",
          "variant": "high"
        }
      ]
    },
    "momus": {
      "model": "openai/gpt-5.5",
      "variant": "xhigh",
      "fallback_models": [
        {
          "model": "litellm/deepseek-v4-pro-thinking"
        },
        {
          "model": "google/gemini-3.1-pro-preview",
          "variant": "high"
        }
      ]
    },
    "atlas": {
      "model": "litellm/kimi-k2.6",
      "fallback_models": [
        {
          "model": "openai/gpt-5.5",
          "variant": "medium"
        }
      ]
    },
    "sisyphus-junior": {
      "model": "openai/gpt-5.5"
    }
  },
  "categories": {
    "visual-engineering": {
      "model": "google/gemini-3.1-pro-preview",
      "variant": "high"
    },
    "ultrabrain": {
      "model": "openai/gpt-5.5",
      "variant": "xhigh",
      "fallback_models": [
        {
          "model": "google/gemini-3.1-pro-preview",
          "variant": "high"
        },
        {
          "model": "litellm/deepseek-v4-pro"
        },
        {
          "model": "litellm/deepseek-v4-pro-thinking"
        }
      ]
    },
    "deep": {
      "model": "openai/gpt-5.5",
      "variant": "medium",
      "fallback_models": [
        {
          "model": "litellm/deepseek-v4-pro"
        },
        {
          "model": "google/gemini-3.1-pro-preview",
          "variant": "high"
        }
      ]
    },
    "artistry": {
      "model": "google/gemini-3.1-pro-preview",
      "variant": "high",
      "fallback_models": [
        {
          "model": "openai/gpt-5.5"
        }
      ]
    },
    "quick": {
      "model": "openai/gpt-5.4-mini",
      "fallback_models": [
        {
          "model": "google/gemini-3-flash-preview"
        }
      ]
    },
    "unspecified-low": {
      "model": "openai/gpt-5.3-codex",
      "fallback_models": [
        {
          "model": "google/gemini-3-flash-preview"
        }
      ]
    },
    "unspecified-high": {
      "model": "litellm/kimi-k2.6",
      "fallback_models": [
        {
          "model": "openai/gpt-5.5",
          "variant": "high"
        }
      ]
    },
    "writing": {
      "model": "google/gemini-3-flash-preview"
    }
  }
}

+import { describe, expect, test } from "bun:test"
+
+import { buildFallbackChainFromModels } from "./fallback-chain-from-models"
+
+describe("buildFallbackChainFromModels empty opt-out", () => {
+  test("#given the user explicitly configures no fallbacks #when building #then it returns an empty chain", () => {
+    const result = buildFallbackChainFromModels([], "omniroute")
+
+    expect(result).toEqual([])
+  })
+
+  test("#given the key is absent #when building #then it returns undefined so the agent default still applies", () => {
+    const result = buildFallbackChainFromModels(undefined, "omniroute")
+
+    expect(result).toBeUndefined()
+  })
+
+  test("#given a non-empty override #when building #then the configured entries win", () => {
+    const result = buildFallbackChainFromModels(["omniroute/foo-chain"], "omniroute")
+
+    expect(result).toHaveLength(1)
+    expect(result?.[0]?.providers).toContain("omniroute")
+  })
+
+  // Only an empty input array is the opt-out; unparseable input keeps the existing undefined bail.
+  test("#given a non-empty but unparseable list #when building #then it still returns undefined", () => {
+    const result = buildFallbackChainFromModels(["   "], "omniroute")
+
+    expect(result).toBeUndefined()
+  })
+})

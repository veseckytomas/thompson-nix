+import { afterAll, describe, expect, mock, test } from "bun:test"
+
+import { buildFallbackChainFromModels } from "../../shared/fallback-chain-from-models"
+import type { FallbackEntry } from "../../shared/model-requirements"
+import type { ProviderModelsCache } from "../../shared/connected-providers-cache"
+import { tryFallbackRetry, type FallbackRetryHandlerDeps } from "./fallback-retry-handler"
+import type { BackgroundTask } from "./types"
+import type { ConcurrencyManager } from "./concurrency"
+import type { OpencodeClient, QueueItem } from "./constants"
+
+const hardcodedLadder: FallbackEntry[] = [
+  { model: "gpt-5.5", providers: ["openai", "github-copilot", "opencode", "vercel"], variant: "high" },
+]
+
+const retryHandlerDeps: Partial<FallbackRetryHandlerDeps> = {
+  log: mock(() => {}),
+  readConnectedProvidersCache: mock(() => null),
+  readProviderModelsCache: mock((): ProviderModelsCache | null => null),
+  shouldRetryError: mock(() => true),
+  getNextFallback: mock((chain: FallbackEntry[], attempt: number) => chain[attempt]),
+  hasMoreFallbacks: mock((chain: FallbackEntry[], attempt: number) => attempt < chain.length),
+  selectFallbackProvider: mock((providers: string[]) => providers[0]),
+  transformModelForProvider: mock((_provider: string, model: string) => model),
+}
+
+function createArgs(fallbackChain: FallbackEntry[] | undefined) {
+  const task: BackgroundTask = {
+    id: "test-task-1",
+    description: "test task",
+    prompt: "test prompt",
+    agent: "oracle",
+    status: "error",
+    parentSessionId: "parent-session-1",
+    parentMessageId: "parent-message-1",
+    fallbackChain,
+    attemptCount: 0,
+    concurrencyKey: "omniroute/oracle-chain",
+    model: { providerID: "omniroute", modelID: "oracle-chain" },
+  }
+
+  return {
+    task,
+    errorInfo: { name: "OverloadedError", message: "model overloaded" },
+    source: "polling",
+    concurrencyManager: {
+      release: mock(() => {}),
+      acquire: mock(async () => {}),
+      getConcurrencyKey: mock((model: string) => model),
+      getQueueLength: mock(() => 0),
+      getActiveCount: mock(() => 0),
+    } as never as ConcurrencyManager,
+    client: { session: { abort: mock(async () => ({})) } } as never as OpencodeClient,
+    idleDeferralTimers: new Map<string, ReturnType<typeof setTimeout>>(),
+    queuesByKey: new Map<string, QueueItem[]>(),
+    processKey: mock(() => {}),
+    deps: retryHandlerDeps,
+  }
+}
+
+describe("tryFallbackRetry with an explicit empty opt-out", () => {
+  afterAll(() => {
+    mock.restore()
+  })
+
+  // Pre-fix, [] collapsed to undefined and `?? ladder` reinstated the hardcoded chain.
+  test("#given fallback_models is [] #when a retryable error arrives #then it does not retry", async () => {
+    const configuredChain = buildFallbackChainFromModels([], "omniroute")
+    const args = createArgs(configuredChain ?? hardcodedLadder)
+
+    const result = await tryFallbackRetry(args)
+
+    expect(result).toBe(false)
+  })
+
+  test("#given fallback_models is [] #when a retryable error arrives #then the task model is unchanged", async () => {
+    const configuredChain = buildFallbackChainFromModels([], "omniroute")
+    const args = createArgs(configuredChain ?? hardcodedLadder)
+
+    await tryFallbackRetry(args)
+
+    expect(args.task.model?.providerID).toBe("omniroute")
+    expect(args.task.model?.modelID).toBe("oracle-chain")
+  })
+})

+import { describe, expect, test } from "bun:test"
+
+import type { ProviderModelsCache } from "./connected-providers-cache"
+import { resolveFallbackPair } from "./fallback-pair-resolver"
+import type { FallbackEntry } from "./model-requirement-types"
+
+function createCatalog(
+	models: ProviderModelsCache["models"],
+	connected: readonly string[] = Object.keys(models),
+): ProviderModelsCache {
+	return { models, connected, updatedAt: "2000-01-01T00:00:00.000Z" }
+}
+
+const oracleLadder: FallbackEntry[] = [
+	{ providers: ["openai", "github-copilot", "opencode", "vercel"], model: "gpt-5.5", variant: "high" },
+	{ providers: ["google", "github-copilot", "opencode", "vercel"], model: "gemini-3.1-pro", variant: "high" },
+	{ providers: ["anthropic", "github-copilot", "opencode", "vercel"], model: "claude-opus-4-7", variant: "max" },
+	{ providers: ["opencode-go", "vercel"], model: "glm-5.1" },
+]
+
+const freeZenModels = [
+	"grok-code",
+	"qwen3-coder",
+	"kimi-k2",
+	"glm-4.6",
+	"gpt-oss-120b",
+	"deepseek-v3.1",
+	"minimax-m2",
+	"big-pickle",
+]
+
+describe("resolveFallbackPair", () => {
+	// The real log showed 10 each of opencode/{gpt-5.5,gemini-3.1-pro,claude-opus-4-7} and zero glm-5.1.
+	test("#given the oracle ladder on this host #when resolving every rung #then no impossible pair is emitted", () => {
+		const catalog = createCatalog(
+			{ opencode: freeZenModels, omniroute: ["oracle-chain", "quick-chain"] },
+			["opencode", "omniroute", "litellm", "google-agy"],
+		)
+
+		const pairs = oracleLadder
+			.map((entry) => resolveFallbackPair(entry, ["opencode", "omniroute", "litellm", "google-agy"], catalog))
+			.filter((pair) => pair !== null)
+
+		expect(pairs).toHaveLength(0)
+		expect(pairs).not.toContainEqual({ providerID: "opencode", modelID: "gpt-5.5" })
+		expect(pairs).not.toContainEqual({ providerID: "opencode", modelID: "gemini-3.1-pro" })
+		expect(pairs).not.toContainEqual({ providerID: "opencode", modelID: "claude-opus-4-7" })
+	})
+
+	test("#given a connected provider serving the model #when resolving #then it returns that exact pair", () => {
+		const catalog = createCatalog({ "provider-a": ["model-1"] })
+
+		const result = resolveFallbackPair({ providers: ["provider-a"], model: "model-1" }, ["provider-a"], catalog)
+
+		expect(result).toEqual({ providerID: "provider-a", modelID: "model-1" })
+	})
+
+	test("#given two serviceable providers #when resolving #then the earlier declared provider wins", () => {
+		const catalog = createCatalog({ "provider-a": ["shared"], "provider-b": ["shared"] })
+
+		const result = resolveFallbackPair(
+			{ providers: ["provider-b", "provider-a"], model: "shared" },
+			["provider-a", "provider-b"],
+			catalog,
+		)
+
+		expect(result).toEqual({ providerID: "provider-b", modelID: "shared" })
+	})
+
+	test("#given a connected provider that does not serve the model #when resolving #then it is not reachable", () => {
+		const catalog = createCatalog({ "provider-a": ["another-model"] })
+
+		const result = resolveFallbackPair({ providers: ["provider-a"], model: "model-1" }, ["provider-a"], catalog)
+
+		expect(result).toBeNull()
+	})
+
+	test("#given connectivity is known but the catalog is missing #when resolving #then the connected provider is still used", () => {
+		const result = resolveFallbackPair({ providers: ["provider-a"], model: "model-1" }, ["provider-a"], null)
+
+		expect(result).toEqual({ providerID: "provider-a", modelID: "model-1" })
+	})
+
+	test("#given a known catalog that omits the provider entirely #when resolving #then the provider is not vetoed", () => {
+		const catalog = createCatalog({ "provider-b": ["model-1"] })
+
+		const result = resolveFallbackPair({ providers: ["provider-a"], model: "model-1" }, ["provider-a"], catalog)
+
+		expect(result).toEqual({ providerID: "provider-a", modelID: "model-1" })
+	})
+
+	test("#given no connectivity information at all #when resolving #then the first provider is used as upstream did", () => {
+		const result = resolveFallbackPair({ providers: ["provider-a", "provider-b"], model: "model-1" }, null, null)
+
+		expect(result).toEqual({ providerID: "provider-a", modelID: "model-1" })
+	})
+
+	test("#given a disconnected provider whose catalog lists the model #when resolving #then it is skipped", () => {
+		const catalog = createCatalog({ "provider-a": ["model-1"] })
+
+		const result = resolveFallbackPair({ providers: ["provider-a"], model: "model-1" }, ["provider-b"], catalog)
+
+		expect(result).toBeNull()
+	})
+
+	test("#given the first provider lacks the model #when resolving #then a later serving provider is used", () => {
+		const catalog = createCatalog({ "provider-a": ["other"], "provider-b": ["model-1"] })
+
+		const result = resolveFallbackPair(
+			{ providers: ["provider-a", "provider-b"], model: "model-1" },
+			["provider-a", "provider-b"],
+			catalog,
+		)
+
+		expect(result).toEqual({ providerID: "provider-b", modelID: "model-1" })
+	})
+
+	test("#given only a loose catalog match #when resolving #then it rejects the pair", () => {
+		const catalog = createCatalog({ "provider-a": ["gpt-5.5-preview"] })
+
+		const result = resolveFallbackPair({ providers: ["provider-a"], model: "gpt-5.5" }, ["provider-a"], catalog)
+
+		expect(result).toBeNull()
+	})
+
+	test("#given an old but valid catalog snapshot #when resolving #then it remains serviceable", () => {
+		const catalog = createCatalog({ "provider-a": [{ id: "model-1" }] as never })
+
+		const result = resolveFallbackPair({ providers: ["provider-a"], model: "model-1" }, ["provider-a"], catalog)
+
+		expect(result).toEqual({ providerID: "provider-a", modelID: "model-1" })
+	})
+})

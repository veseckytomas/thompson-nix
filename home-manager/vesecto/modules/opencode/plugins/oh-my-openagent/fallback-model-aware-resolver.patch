+import { beforeEach, describe, expect, mock, test } from "bun:test"
+import { tryFallbackRetry, type FallbackRetryHandlerDeps } from "./fallback-retry-handler"
+import type { FallbackEntry } from "../../shared/model-requirements"
+import type { ProviderModelsCache } from "../../shared/connected-providers-cache"
+import type { BackgroundTask } from "./types"
+import type { ConcurrencyManager } from "./concurrency"
+import type { OpencodeClient, QueueItem } from "./constants"
+
+const logMock = mock(() => {})
+const readConnectedProvidersCacheMock = mock((): string[] | null => null)
+const readProviderModelsCacheMock = mock((): ProviderModelsCache | null => null)
+const shouldRetryErrorMock = mock(() => true)
+const getNextFallbackMock = mock((chain: FallbackEntry[], attempt: number) => chain[attempt])
+const hasMoreFallbacksMock = mock((chain: FallbackEntry[], attempt: number) => attempt < chain.length)
+
+const deps: Partial<FallbackRetryHandlerDeps> = {
+	log: logMock,
+	readConnectedProvidersCache: readConnectedProvidersCacheMock,
+	readProviderModelsCache: readProviderModelsCacheMock,
+	shouldRetryError: shouldRetryErrorMock,
+	getNextFallback: getNextFallbackMock,
+	hasMoreFallbacks: hasMoreFallbacksMock,
+}
+
+const oracleLadder: FallbackEntry[] = [
+	{ model: "gpt-5.5", providers: ["openai", "github-copilot", "opencode", "vercel"], variant: "high" },
+	{ model: "gemini-3.1-pro", providers: ["google", "github-copilot", "opencode", "vercel"], variant: "high" },
+	{ model: "claude-opus-4-7", providers: ["anthropic", "github-copilot", "opencode", "vercel"], variant: "max" },
+	{ model: "glm-5.1", providers: ["opencode-go", "vercel"], variant: undefined },
+]
+
+const freeZenModels = [
+	"grok-code",
+	"code-supernova-1-million",
+	"qwen3-coder",
+	"kimi-k2",
+	"glm-4-6",
+	"minimax-m2",
+	"gpt-oss-120b",
+	"big-pickle",
+]
+
+function createMockConcurrencyManager(): ConcurrencyManager {
+	return {
+		release: mock(() => {}),
+		acquire: mock(async () => {}),
+		getConcurrencyKey: mock((model: string) => model),
+		getQueueLength: mock(() => 0),
+		getActiveCount: mock(() => 0),
+	} as never
+}
+
+function createMockClient(): OpencodeClient {
+	return { session: { abort: mock(async () => ({})) } } as never
+}
+
+function createArgs(taskOverrides: Partial<BackgroundTask> = {}) {
+	const task: BackgroundTask = {
+		id: "test-task-model-aware",
+		description: "test task",
+		prompt: "test prompt",
+		agent: "oracle",
+		status: "error",
+		parentSessionId: "parent-session-1",
+		parentMessageId: "parent-message-1",
+		fallbackChain: oracleLadder,
+		attemptCount: 0,
+		concurrencyKey: "omniroute/oracle-chain",
+		model: { providerID: "omniroute", modelID: "oracle-chain" },
+		...taskOverrides,
+	}
+
+	return {
+		task,
+		errorInfo: { name: "OverloadedError", message: "model overloaded" },
+		source: "polling",
+		concurrencyManager: createMockConcurrencyManager(),
+		client: createMockClient(),
+		idleDeferralTimers: new Map<string, ReturnType<typeof setTimeout>>(),
+		queuesByKey: new Map<string, QueueItem[]>(),
+		processKey: mock(() => {}),
+		deps,
+	}
+}
+
+describe("tryFallbackRetry model-aware fallback selection", () => {
+	beforeEach(() => {
+		logMock.mockClear()
+		readConnectedProvidersCacheMock.mockReturnValue(null)
+		readProviderModelsCacheMock.mockReturnValue(null)
+		shouldRetryErrorMock.mockReturnValue(true)
+		getNextFallbackMock.mockImplementation((chain: FallbackEntry[], attempt: number) => chain[attempt])
+		hasMoreFallbacksMock.mockImplementation((chain: FallbackEntry[], attempt: number) => attempt < chain.length)
+	})
+
+	// This is the exact host state that produced 10 each of opencode/{gpt-5.5,gemini-3.1-pro,claude-opus-4-7}.
+	test("#given no connected provider serves any ladder model #when retrying #then no retry is attempted", async () => {
+		readProviderModelsCacheMock.mockReturnValue({
+			connected: ["opencode", "omniroute", "litellm", "google-agy"],
+			models: { opencode: freeZenModels, omniroute: ["oracle-chain", "quick-chain"] },
+			updatedAt: new Date("2026-10-01T00:00:00.000Z").toISOString(),
+		})
+
+		const args = createArgs()
+
+		const result = await tryFallbackRetry(args)
+
+		expect(result).toBe(false)
+		expect(args.task.model).toEqual({ providerID: "omniroute", modelID: "oracle-chain" })
+	})
+
+	test("#given a connected provider that genuinely serves a ladder model #when retrying #then that pair is used", async () => {
+		readProviderModelsCacheMock.mockReturnValue({
+			connected: ["opencode", "anthropic"],
+			models: { opencode: freeZenModels, anthropic: ["claude-opus-4-7"] },
+			updatedAt: new Date("2026-10-01T00:00:00.000Z").toISOString(),
+		})
+
+		const args = createArgs()
+
+		const result = await tryFallbackRetry(args)
+
+		expect(result).toBe(true)
+		expect(args.task.model).toEqual({ providerID: "anthropic", modelID: "claude-opus-4-7", variant: "max" })
+	})
+
+	test("#given a disconnected provider serving the model #when retrying #then the preferred provider is not substituted", async () => {
+		readProviderModelsCacheMock.mockReturnValue({
+			connected: ["omniroute"],
+			models: { anthropic: ["claude-opus-4-7"], omniroute: ["oracle-chain"] },
+			updatedAt: new Date("2026-10-01T00:00:00.000Z").toISOString(),
+		})
+
+		const args = createArgs()
+
+		const result = await tryFallbackRetry(args)
+
+		expect(result).toBe(false)
+		expect(args.task.model).toEqual({ providerID: "omniroute", modelID: "oracle-chain" })
+	})
+})

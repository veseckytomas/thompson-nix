+import type { ProviderModelsCache } from "./connected-providers-cache"
+import type { FallbackEntry } from "./model-requirement-types"
+import { transformModelForProvider } from "./provider-model-id-transform"
+
+export type FallbackPair = {
+	readonly providerID: string
+	readonly modelID: string
+}
+
+function modelIDOf(entry: string | { readonly id: string }): string {
+	return typeof entry === "string" ? entry : entry.id
+}
+
+function servesModel(
+	modelCatalog: ProviderModelsCache | null,
+	providerID: string,
+	modelID: string,
+): boolean {
+	const catalogModels = modelCatalog?.models[providerID]
+	// An absent or empty inventory means "unknown", not "serves nothing".
+	if (!catalogModels || catalogModels.length === 0) return true
+	return catalogModels.some((catalogEntry) => modelIDOf(catalogEntry) === modelID)
+}
+
+export function resolveFallbackPair(
+	entry: FallbackEntry,
+	connectedProviders: readonly string[] | null,
+	modelCatalog: ProviderModelsCache | null,
+	preferredProviderID?: string,
+): FallbackPair | null {
+	const connectivity = connectedProviders ?? modelCatalog?.connected ?? null
+
+	// No connectivity info at all: proceed as upstream did rather than block every fallback.
+	if (!connectivity) {
+		const providerID = entry.providers[0] ?? preferredProviderID
+		if (!providerID) return null
+		return { providerID, modelID: transformModelForProvider(providerID, entry.model) }
+	}
+
+	const connectedSet = new Set(connectivity.map((provider) => provider.toLowerCase()))
+
+	const candidates = preferredProviderID ? [...entry.providers, preferredProviderID] : entry.providers
+
+	for (const providerID of candidates) {
+		if (!connectedSet.has(providerID.toLowerCase())) continue
+
+		const modelID = transformModelForProvider(providerID, entry.model)
+		if (servesModel(modelCatalog, providerID, modelID)) {
+			return { providerID, modelID }
+		}
+	}
+
+	return null
+}

The root build script became a parallel DAG runner (script/build.ts +
script/build-nodes.ts), and two of its 16 nodes cannot build in the Nix sandbox:
build:codex-plugin runs `npm --prefix packages/omo-codex/plugin ci`, and that
package is not a bun workspace member, so its ten components have no
node_modules in the vendored bun tree and there is no network to fetch them.
senpi-plugin is excluded only because it declares codex-plugin as a dependency,
so leaving it in would stall the graph on an unresolved edge.

Upstream already supports exactly this via OMO_BUILD_PROFILE, so rather than
deleting the two array entries (which three upstream test files assert the
existence of), this registers a `nix` profile. The profile is computed by
SUBTRACTION, so it stays a denylist: a node added upstream is picked up
automatically and fails loudly if it cannot build offline, instead of being
silently dropped by an allowlist that nobody remembered to update.

Nothing in installPhase consumes either excluded node: the published entrypoint
is dist/index.js from the `index` node, whose deps are empty.

--- a/script/build-nodes.ts
+++ b/script/build-nodes.ts
@@ -26,6 +26,10 @@
 	{ id: "omo-schema", command: "bun", args: ["run", "build:omo-schema"], deps: [] },
 ]
 
+// The nix profile is a denylist by subtraction: a node added upstream is picked up automatically
+// and fails loudly if it cannot build offline, rather than being silently dropped.
+const NIX_EXCLUDED_NODES: readonly string[] = ["codex-plugin", "senpi-plugin"]
+
 /**
  * A profile names the nodes a consumer actually needs; its dependency closure is added
  * automatically.
@@ -40,6 +44,7 @@
  */
 export const BUILD_PROFILES: Record<string, readonly string[]> = {
 	"omo-native": ["lsp-daemon", "ast-grep-mcp"],
+	nix: BUILD_NODES.map((node) => node.id).filter((id) => !NIX_EXCLUDED_NODES.includes(id)),
 }
 
 export function selectBuildNodes(

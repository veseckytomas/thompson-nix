{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",
  "auto_update": false,
  "runtime_fallback": {
    "enabled": false
  },
  "codegraph": {
    "enabled": true,
    "auto_init": false,
    "auto_provision": true,
    "daemon": true
  },
  "team_mode": {
